{
  "expo": {
    "name": "Binotto",
    "owner": "binotto-team",
    "slug": "binotto",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./src/assets/icon.png",
    "splash": {
      "image": "./src/assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FACC15"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.binotto.mobile",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "NSUserNotificationsUsageDescription": "Permita notificações para receber atualizações importantes sobre o status das suas solicitações de serviços."
      },
      "appleTeamId": "H8Y8NDU7D5"
    },
    "android": {
      "package": "com.binotto.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/icon.png",
        "backgroundColor": "#FACC15"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "extra": {
      "eas": {
        "projectId": "e02baef9-1b61-4916-b52f-6520c2e4d150"
      }
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite selecionar fotos dos veículos para anexar em serviços e orçamentos.",
          "cameraPermission": "Permite capturar fotos dos veículos para registro e acompanhamento dos serviços."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-localization",
      [
        "expo-notifications",
        {
          "enableBackgroundRemoteNotifications": true
        }
      ],
      "@react-native-google-signin/google-signin"
    ]
  }
}
